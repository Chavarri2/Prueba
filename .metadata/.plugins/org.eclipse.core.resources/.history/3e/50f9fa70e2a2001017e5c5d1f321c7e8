package bucles;
import java.io.File;

public class ifs {

	public class Delete {
	    public static void delete(File file) {
	        File[] contents = file.listFiles();
	        if (contents != null) {
	            for (File f : contents) {
	                delete(f);
	            }
	        }
	        file.delete();
	    }

	    public static void main(String[] args) {
	        delete(new File("C:/Users/AluDAM/Documents/prueba"));
	    }
	}
}