import java.util.Scanner;

public class Ejercicio1 {

	public static void main(String[] args) {
		// Declaración de variables
        int a, b, suma=0;
        Scanner scanner = new Scanner(System.in);       
        // Entrada de datos
        System.out.print("Ingrese un numero: ");
        a = scanner.nextInt();
        System.out.print("Ingrese un numero mayor que el anterior: ");
        b = scanner.nextInt();
        //proceso
        while (a > b) {
            System.out.println("\nError: a debe ser menor o igual que b");
            System.out.print("Ingrese el valor de a: ");
            a = scanner.nextInt();
            System.out.print("Ingrese el valor de b: ");
            b = scanner.nextInt();
        }
        for (int i = a; i <= b; i++) {
            if (i % 2 != 0) {
                suma += i;
            }
        }
        
        // Salida de datos
        System.out.println("La suma de los números impares entre " + a + " y " + b + " es: " + suma);
        System.out.println("Fin del programa");
        scanner.close();
	}

}
